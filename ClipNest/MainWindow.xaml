<Window
    x:Class="ClipNest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ClipNest.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ClipNest"
    Width="450"
    Height="300"
    MinWidth="450"
    MinHeight="300"
    MaxWidth="900"
    MaxHeight="600"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI"
    Icon="Assets/ClipNest.ico"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseWheel="Window_PreviewMouseWheel"
    PreviewTextInput="Window_PreviewTextInput"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="WindowSurface"
            Margin="6"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DragSurface"
                    Grid.Row="0"
                    Background="{StaticResource ChromeBrush}"
                    CornerRadius="11,11,0,0"
                    PreviewMouseWheel="DragSurface_PreviewMouseWheel">
                    <Grid Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="Assets/ClipNest.ico" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="ClipNest" />
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Button
                                x:Name="MoreButton"
                                Width="26"
                                Height="26"
                                AutomationProperties.Name="更多操作"
                                Click="MoreButton_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="更多操作">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Data="M3,8 L3.1,8 M8,8 L8.1,8 M13,8 L13.1,8"
                                    Style="{StaticResource IconPathStyle}"
                                    StrokeThickness="3" />
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource ClipContextMenuStyle}">
                                        <MenuItem
                                            x:Name="HotKeyStatusMenuItem"
                                            Header="快捷键已启用"
                                            Style="{StaticResource ClipMenuItemStyle}" />
                                        <MenuItem
                                            x:Name="SettingsMenuItem"
                                            Click="SettingsMenuItem_Click"
                                            Header="设置..."
                                            Style="{StaticResource ClipMenuItemStyle}" />
                                        <MenuItem
                                            x:Name="AutoHideMenuItem"
                                            Click="AutoHideMenuItem_Click"
                                            Header="复制后自动隐藏"
                                            IsCheckable="True"
                                            Style="{StaticResource ClipMenuItemStyle}" />
                                        <Separator />
                                        <MenuItem
                                            x:Name="ClearHistoryMenuItem"
                                            Click="ClearHistoryMenuItem_Click"
                                            Header="清空历史"
                                            IsEnabled="{Binding HasItems}"
                                            Style="{StaticResource DangerClipMenuItemStyle}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Ellipse
                                x:Name="HotKeyConflictDot"
                                Width="6"
                                Height="6"
                                Margin="0,3,3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{StaticResource AccentBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        </Grid>

                        <Button
                            x:Name="HideButton"
                            Grid.Column="3"
                            Width="26"
                            Height="26"
                            AutomationProperties.Name="隐藏 ClipNest"
                            Click="HideButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="隐藏">
                            <Path
                                Width="12"
                                Height="12"
                                Data="M2.5,5 L7,9.5 L11.5,5"
                                Style="{StaticResource IconPathStyle}" />
                        </Button>
                    </Grid>
                </Border>

                <Border
                    x:Name="SearchPanel"
                    Grid.Row="1"
                    Margin="9,0,9,5"
                    Padding="5,3"
                    Background="#FFF7F9F6"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding IsSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path
                                Width="13"
                                Height="13"
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"
                                Data="M6.5,2 A4.5,4.5 0 1 0 6.5,11 A4.5,4.5 0 0 0 6.5,2 Z M10,10 L14,14"
                                Fill="Transparent"
                                Stretch="Uniform"
                                Stroke="{StaticResource MutedBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5" />
                            <TextBox
                                x:Name="SearchTextBox"
                                Grid.Column="1"
                                Padding="0,4"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{StaticResource InkBrush}"
                                FontSize="12.5"
                                Foreground="{StaticResource InkBrush}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                Width="22"
                                Height="22"
                                AutomationProperties.Name="收起搜索"
                                Click="CloseSearchButton_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="清空并收起 (Esc)">
                                <Path
                                    Width="9"
                                    Height="9"
                                    Data="M2,2 L10,10 M10,2 L2,10"
                                    Style="{StaticResource IconPathStyle}" />
                            </Button>
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <RadioButton
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="All"
                                Content="全部"
                                GroupName="HistoryFilter"
                                IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                                Style="{StaticResource SearchFilterPillStyle}" />
                            <RadioButton
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="Text"
                                Content="文本"
                                GroupName="HistoryFilter"
                                IsChecked="{Binding IsTextFilter, Mode=OneWay}"
                                Style="{StaticResource SearchFilterPillStyle}" />
                            <RadioButton
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="Image"
                                Content="图片"
                                GroupName="HistoryFilter"
                                IsChecked="{Binding IsImageFilter, Mode=OneWay}"
                                Style="{StaticResource SearchFilterPillStyle}" />
                            <RadioButton
                                Command="{Binding SetFilterCommand}"
                                CommandParameter="Pinned"
                                Content="置顶"
                                GroupName="HistoryFilter"
                                IsChecked="{Binding IsPinnedFilter, Mode=OneWay}"
                                Style="{StaticResource SearchFilterPillStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Background="{StaticResource PanelBrush}">
                    <ScrollViewer
                        x:Name="HistoryScrollViewer"
                        Padding="2,1,1,1"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="HistoryItemsControl"
                            ItemsSource="{Binding VisibleItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveCardPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="ItemCard"
                                        Margin="2,1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="ClipItem_MouseLeftButtonDown"
                                        MouseLeftButtonUp="ClipItem_MouseLeftButtonUp"
                                        MouseRightButtonUp="ClipItem_MouseRightButtonUp"
                                        Tag="ClipItem"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        SnapsToDevicePixels="True">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#FFFFFFFF" />
                                                <Setter Property="BorderBrush" Value="#FFE9EEEB" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                        <Setter Property="Background" Value="#FFF1F7F4" />
                                                        <Setter Property="BorderBrush" Value="#FFDCEAE3" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#FFD5DFDA" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SeaBrush}" />
                                                        <Setter Property="Background" Value="#FFF8FCFA" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Border
                                                x:Name="PinnedBar"
                                                Width="3"
                                                Margin="4,8,0,8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="2"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />

                                            <Grid
                                                x:Name="TextLayout"
                                                MinHeight="48"
                                                Margin="14,4,10,4">
                                                <TextBlock
                                                    MaxHeight="114"
                                                    VerticalAlignment="Center"
                                                    FontSize="{Binding DisplayFontSize}"
                                                    Foreground="{StaticResource InkBrush}"
                                                    LineHeight="{Binding DisplayLineHeight}"
                                                    Text="{Binding DisplayText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap"
                                                    ToolTip="{Binding TooltipText}" />
                                            </Grid>

                                            <Grid
                                                x:Name="ImageLayout"
                                                Margin="6"
                                                ToolTip="双击查看大图"
                                                Visibility="Collapsed">
                                                <Border
                                                    Background="#FFF0F3F1"
                                                    CornerRadius="8" />
                                                <Border
                                                    CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush
                                                            AlignmentX="Center"
                                                            AlignmentY="Center"
                                                            ImageSource="{Binding ImagePreview}"
                                                            Stretch="Uniform" />
                                                    </Border.Background>
                                                </Border>
                                                <Border
                                                    x:Name="ImageDimensionBadge"
                                                    Margin="0,0,0,0"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="#D91D282A"
                                                    CornerRadius="5"
                                                    IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
                                                                    Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        Foreground="#FFFFFFFF"
                                                        Text="{Binding ImageDimensionsLabel}" />
                                                </Border>
                                            </Grid>

                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter TargetName="TextLayout" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ImageLayout" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                            <Setter TargetName="PinnedBar" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid
                        Margin="18"
                        Background="Transparent"
                        IsHitTestVisible="False">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border
                                Width="42"
                                Height="42"
                                HorizontalAlignment="Center"
                                Background="{StaticResource SeaSoftBrush}"
                                CornerRadius="10">
                                <Path
                                    Width="22"
                                    Height="22"
                                    Data="M7,4.5 L17,4.5 L17,20 L7,20 Z M10,1.5 L20,1.5 L20,17 M10,9 L14,9 M10,12.5 L14,12.5 M10,16 L14,16"
                                    Fill="Transparent"
                                    Stretch="Uniform"
                                    Stroke="{StaticResource SeaBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Border>
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="{Binding EmptyStateTitle}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}"
                                Text="{Binding EmptyStateDetail}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="EditOverlay"
                        Panel.ZIndex="10"
                        Background="{StaticResource PanelBrush}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="8,7,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="2,0,0,5"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="编辑内容" />
                            <TextBox
                                x:Name="EditTextBox"
                                Grid.Row="1"
                                Padding="7,4"
                                Style="{StaticResource EditorTextBoxStyle}"
                                Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    MinWidth="64"
                                    Padding="11,5"
                                    Command="{Binding CancelEditCommand}"
                                    Content="取消"
                                    Style="{StaticResource QuietTextButtonStyle}" />
                                <Button
                                    MinWidth="64"
                                    Margin="6,0,0,0"
                                    Padding="11,5"
                                    Command="{Binding SaveEditCommand}"
                                    Content="保存"
                                    Style="{StaticResource TextButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="ImageEditOverlay"
                        Panel.ZIndex="12"
                        Background="{StaticResource PanelBrush}"
                        Visibility="{Binding IsEditingImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="8,7,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="2,0,0,5"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="编辑图片" />
                            <Border
                                Grid.Row="1"
                                Background="#FFF0F3F1"
                                CornerRadius="8">
                                <Grid>
                                    <Image
                                        Margin="12"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding ImageEditPreview}"
                                        Stretch="Uniform" />
                                    <Border
                                        Margin="8"
                                        Padding="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#E61D282A"
                                        CornerRadius="9">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                AutomationProperties.Name="向左旋转"
                                                Command="{Binding RotateImageLeftCommand}"
                                                Style="{StaticResource OverlayIconButtonStyle}"
                                                ToolTip="向左旋转">
                                                <Path
                                                    Data="M8,3 A5,5 0 1 0 13,8 M8,3 L5,0 M8,3 L11,0"
                                                    Style="{StaticResource IconPathStyle}" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="向右旋转"
                                                Command="{Binding RotateImageRightCommand}"
                                                Style="{StaticResource OverlayIconButtonStyle}"
                                                ToolTip="向右旋转">
                                                <Path
                                                    Data="M8,3 A5,5 0 1 1 3,8 M8,3 L5,0 M8,3 L11,0"
                                                    Style="{StaticResource IconPathStyle}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    MinWidth="64"
                                    Padding="11,5"
                                    Command="{Binding CancelImageEditCommand}"
                                    Content="取消"
                                    Style="{StaticResource QuietTextButtonStyle}" />
                                <Button
                                    MinWidth="64"
                                    Margin="6,0,0,0"
                                    Padding="11,5"
                                    Command="{Binding SaveImageEditCommand}"
                                    Content="保存"
                                    Style="{StaticResource TextButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="ToastHost"
                        Panel.ZIndex="20"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Opacity="0"
                        Visibility="Collapsed">
                        <Border
                            Padding="9,4,6,4"
                            Background="#F21D282A"
                            CornerRadius="7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="ToastMessage"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="#FFFFFFFF" />
                                <Button
                                    x:Name="UndoToastButton"
                                    Click="UndoToastButton_Click"
                                    Content="撤销"
                                    Style="{StaticResource ToastActionButtonStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid
            x:Name="ImagePreviewOverlay"
            Panel.ZIndex="40"
            Margin="6"
            Background="#F2F1F3F1"
            MouseLeftButtonDown="ImagePreviewOverlay_MouseLeftButtonDown"
            Visibility="Collapsed">
            <Image
                x:Name="ImagePreviewLarge"
                Margin="26,32,26,34"
                RenderOptions.BitmapScalingMode="HighQuality"
                Stretch="Uniform" />
            <Border
                Margin="0,0,0,10"
                Padding="8,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#B3000000"
                CornerRadius="6"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="ImagePreviewDimensions"
                    FontSize="10.5"
                    Foreground="#FFFFFFFF" />
            </Border>
            <Button
                Margin="0,8,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="关闭图片预览"
                Click="ImagePreviewCloseButton_Click"
                Style="{StaticResource IconButtonStyle}"
                ToolTip="关闭 (Esc)">
                <Path
                    Width="11"
                    Height="11"
                    Data="M2,2 L10,10 M10,2 L2,10"
                    Style="{StaticResource IconPathStyle}" />
            </Button>
        </Grid>

        <Thumb
            x:Name="ResizeGrip"
            Panel.ZIndex="35"
            Width="19"
            Height="19"
            Margin="0,0,3,3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Cursor="SizeNWSE"
            DragDelta="ResizeGrip_DragDelta"
            ToolTip="拖拽调整窗口大小">
            <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent">
                        <Path
                            Width="10"
                            Height="10"
                            Margin="0,0,3,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="M2,12 L12,2 M7,12 L12,7"
                            Fill="Transparent"
                            Stretch="Uniform"
                            Stroke="#FF9EAAA5"
                            StrokeEndLineCap="Round"
                            StrokeThickness="1.3" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
