<Window
    x:Class="ClipNest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ClipNest.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ClipNest"
    Width="450"
    Height="300"
    MinWidth="450"
    MinHeight="300"
    MaxWidth="900"
    MaxHeight="600"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI"
    Icon="Assets/ClipNest.ico"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseWheel="Window_PreviewMouseWheel"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Border
            x:Name="WindowSurface"
            Margin="6"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource WindowShadow}"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DragSurface"
                    Grid.Row="0"
                    Background="{StaticResource ChromeBrush}"
                    CornerRadius="11,11,0,0"
                    PreviewMouseWheel="DragSurface_PreviewMouseWheel">
                    <Grid Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="Assets/ClipNest.ico" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="ClipNest" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="11.2"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{Binding HistorySummary}" />

                        <Button
                            Grid.Column="3"
                            Width="26"
                            Height="26"
                            AutomationProperties.Name="隐藏 ClipNest"
                            Click="HideButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="隐藏 (F4)">
                            <Path
                                Width="12"
                                Height="12"
                                Data="M2.5,5 L7,9.5 L11.5,5"
                                Style="{StaticResource IconPathStyle}" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="{StaticResource PanelBrush}">
                    <ScrollViewer
                        x:Name="HistoryScrollViewer"
                        Padding="2,1,1,1"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveCardPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="ItemCard"
                                        Margin="2,1"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ClipItem_MouseLeftButtonUp"
                                        MouseRightButtonUp="ClipItem_MouseRightButtonUp"
                                        Tag="ClipItem"
                                        ToolTip="单击复制，右键查看更多操作"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        SnapsToDevicePixels="True">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#FFFFFFFF" />
                                                <Setter Property="BorderBrush" Value="#FFE9EEEB" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                        <Setter Property="Background" Value="#FFF1F7F4" />
                                                        <Setter Property="BorderBrush" Value="#FFDCEAE3" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#FFD5DFDA" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Border
                                                x:Name="PinnedBar"
                                                Width="3"
                                                Margin="4,8,0,8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="2"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />

                                            <Grid
                                                x:Name="TextLayout"
                                                MinHeight="48"
                                                Margin="14,0,10,0">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13.5"
                                                    Foreground="{StaticResource InkBrush}"
                                                    LineHeight="19"
                                                    Text="{Binding DisplayText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap"
                                                    ToolTip="{Binding TooltipText}" />
                                            </Grid>

                                            <Grid
                                                x:Name="ImageLayout"
                                                Margin="6"
                                                Visibility="Collapsed">
                                                <Border
                                                    Background="#FFF0F3F1"
                                                    CornerRadius="8" />
                                                <Border
                                                    CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush
                                                            AlignmentX="Center"
                                                            AlignmentY="Center"
                                                            ImageSource="{Binding ImagePreview}"
                                                            Stretch="Uniform" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter TargetName="TextLayout" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ImageLayout" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                            <Setter TargetName="PinnedBar" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid
                        Margin="18"
                        Background="Transparent"
                        IsHitTestVisible="False">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border
                                Width="42"
                                Height="42"
                                HorizontalAlignment="Center"
                                Background="{StaticResource SeaSoftBrush}"
                                CornerRadius="10">
                                <Path
                                    Width="22"
                                    Height="22"
                                    Data="M7,4.5 L17,4.5 L17,20 L7,20 Z M10,1.5 L20,1.5 L20,17 M10,9 L14,9 M10,12.5 L14,12.5 M10,16 L14,16"
                                    Fill="Transparent"
                                    Stretch="Uniform"
                                    Stroke="{StaticResource SeaBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Border>
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="粘贴板还是空的" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="EditOverlay"
                        Panel.ZIndex="10"
                        Background="{StaticResource PanelBrush}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="8,7,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="2,0,0,5"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="编辑内容" />
                            <TextBox
                                x:Name="EditTextBox"
                                Grid.Row="1"
                                Padding="7,4"
                                Style="{StaticResource EditorTextBoxStyle}"
                                Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    MinWidth="64"
                                    Padding="11,5"
                                    Command="{Binding CancelEditCommand}"
                                    Content="取消"
                                    Style="{StaticResource QuietTextButtonStyle}" />
                                <Button
                                    MinWidth="64"
                                    Margin="6,0,0,0"
                                    Padding="11,5"
                                    Command="{Binding SaveEditCommand}"
                                    Content="保存"
                                    Style="{StaticResource TextButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="ImageEditOverlay"
                        Panel.ZIndex="12"
                        Background="{StaticResource PanelBrush}"
                        Visibility="{Binding IsEditingImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="8,7,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="2,0,0,5"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="编辑图片" />
                            <Border
                                Grid.Row="1"
                                Background="#FFF0F3F1"
                                CornerRadius="8">
                                <Grid>
                                    <Image
                                        Margin="12"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding ImageEditPreview}"
                                        Stretch="Uniform" />
                                    <Border
                                        Margin="8"
                                        Padding="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#E61D282A"
                                        CornerRadius="9">
                                        <StackPanel Orientation="Horizontal">
                                            <Button
                                                AutomationProperties.Name="向左旋转"
                                                Command="{Binding RotateImageLeftCommand}"
                                                Style="{StaticResource OverlayIconButtonStyle}"
                                                ToolTip="向左旋转">
                                                <Path
                                                    Data="M8,3 A5,5 0 1 0 13,8 M8,3 L5,0 M8,3 L11,0"
                                                    Style="{StaticResource IconPathStyle}" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="向右旋转"
                                                Command="{Binding RotateImageRightCommand}"
                                                Style="{StaticResource OverlayIconButtonStyle}"
                                                ToolTip="向右旋转">
                                                <Path
                                                    Data="M8,3 A5,5 0 1 1 3,8 M8,3 L5,0 M8,3 L11,0"
                                                    Style="{StaticResource IconPathStyle}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    MinWidth="64"
                                    Padding="11,5"
                                    Command="{Binding CancelImageEditCommand}"
                                    Content="取消"
                                    Style="{StaticResource QuietTextButtonStyle}" />
                                <Button
                                    MinWidth="64"
                                    Margin="6,0,0,0"
                                    Padding="11,5"
                                    Command="{Binding SaveImageEditCommand}"
                                    Content="保存"
                                    Style="{StaticResource TextButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="ToastHost"
                        Panel.ZIndex="20"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Opacity="0"
                        Visibility="Collapsed">
                        <Border
                            Padding="9,4,6,4"
                            Background="#F21D282A"
                            CornerRadius="7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="ToastMessage"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="#FFFFFFFF" />
                                <Button
                                    x:Name="UndoToastButton"
                                    Click="UndoToastButton_Click"
                                    Content="撤销"
                                    Style="{StaticResource ToastActionButtonStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
