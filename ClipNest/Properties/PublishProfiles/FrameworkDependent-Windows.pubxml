<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <SelfContained>false</SelfContained>
    <DebugType>None</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\artifacts\windows-$(Version)\</PublishDir>
  </PropertyGroup>

  <Target Name="RenamePublishedExecutable" AfterTargets="Publish">
    <Delete Files="$(PublishDir)ClipNest-$(Version).exe" />
    <Move
      SourceFiles="$(PublishDir)ClipNest.exe"
      DestinationFiles="$(PublishDir)ClipNest-$(Version).exe"
      OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
