<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="InkColor">#FF1D282A</Color>
    <Color x:Key="MutedColor">#FF6F7D7F</Color>
    <Color x:Key="LineColor">#FFE5E9E6</Color>
    <Color x:Key="WindowEdgeColor">#FFD3DCD7</Color>
    <Color x:Key="CanvasColor">#FFFFFFFF</Color>
    <Color x:Key="PanelColor">#FFFFFFFF</Color>
    <Color x:Key="HistorySurfaceColor">#FFFCFEFE</Color>
    <Color x:Key="ChromeColor">#FFEDF5F1</Color>
    <Color x:Key="AccentColor">#FFDF6049</Color>
    <Color x:Key="AccentSoftColor">#FFFFEDE8</Color>
    <Color x:Key="SeaColor">#FF176D69</Color>
    <Color x:Key="SeaSoftColor">#FFE5F2ED</Color>
    <Color x:Key="PrimaryActionColor">#FF176D69</Color>
    <Color x:Key="DangerActionColor">#FFDF6049</Color>
    <Color x:Key="SubtleSurfaceColor">#FFF7F9F6</Color>
    <Color x:Key="ToolTipSurfaceColor">#FFF1F3F1</Color>
    <Color x:Key="ToolTipBorderColor">#FFD8DEDB</Color>
    <Color x:Key="QuietButtonColor">#FFF0F2EF</Color>
    <Color x:Key="SwitchTrackOffColor">#FFDCE4E0</Color>
    <Color x:Key="SwitchTrackOffBorderColor">#FFD2DCD7</Color>
    <Color x:Key="SwitchThumbColor">#FFFFFFFF</Color>
    <Color x:Key="HoverSurfaceColor">#FFF2F5F2</Color>
    <Color x:Key="ScrollThumbColor">#FFC9D2CE</Color>
    <Color x:Key="InputSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="CardSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="CardBorderColor">#FFE9EEEB</Color>
    <Color x:Key="CardPinnedBorderColor">#FFDCEAE3</Color>
    <Color x:Key="CardHoverBorderColor">#FFD5DFDA</Color>
    <Color x:Key="CardSelectedSurfaceColor">#FFF8FCFA</Color>
    <Color x:Key="MediaBackdropColor">#FFF0F3F1</Color>
    <Color x:Key="FloatingToolbarColor">#F2FFFFFF</Color>
    <Color x:Key="FloatingToolbarBorderColor">#24000000</Color>
    <Color x:Key="FloatingToolbarDividerColor">#22000000</Color>
    <Color x:Key="ToastSurfaceColor">#F26B7472</Color>
    <Color x:Key="ToastForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="ToastHoverColor">#22FFFFFF</Color>
    <Color x:Key="PreviewOverlayColor">#F2F1F3F1</Color>
    <Color x:Key="PreviewBadgeColor">#80000000</Color>
    <Color x:Key="DimensionBadgeColor">#D91D282A</Color>
    <Color x:Key="ResizeGripColor">#FF9EAAA5</Color>
    <Color x:Key="OverlayButtonColor">#99000000</Color>
    <Color x:Key="OverlayButtonHoverColor">#CC000000</Color>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="WindowEdgeBrush" Color="{StaticResource WindowEdgeColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="HistorySurfaceBrush" Color="{StaticResource HistorySurfaceColor}" />
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SeaBrush" Color="{StaticResource SeaColor}" />
    <SolidColorBrush x:Key="SeaSoftBrush" Color="{StaticResource SeaSoftColor}" />
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="{StaticResource PrimaryActionColor}" />
    <SolidColorBrush x:Key="PrimaryActionForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DangerActionBrush" Color="{StaticResource DangerActionColor}" />
    <SolidColorBrush x:Key="DangerActionForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{StaticResource SubtleSurfaceColor}" />
    <SolidColorBrush x:Key="ToolTipSurfaceBrush" Color="{StaticResource ToolTipSurfaceColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource ToolTipBorderColor}" />
    <SolidColorBrush x:Key="QuietButtonBrush" Color="{StaticResource QuietButtonColor}" />
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="{StaticResource SwitchTrackOffColor}" />
    <SolidColorBrush x:Key="SwitchTrackOffBorderBrush" Color="{StaticResource SwitchTrackOffBorderColor}" />
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="{StaticResource SwitchThumbColor}" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="InputSurfaceBrush" Color="{StaticResource InputSurfaceColor}" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardPinnedBorderBrush" Color="{StaticResource CardPinnedBorderColor}" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{StaticResource CardHoverBorderColor}" />
    <SolidColorBrush x:Key="CardSelectedSurfaceBrush" Color="{StaticResource CardSelectedSurfaceColor}" />
    <SolidColorBrush x:Key="MediaBackdropBrush" Color="{StaticResource MediaBackdropColor}" />
    <SolidColorBrush x:Key="FloatingToolbarBrush" Color="{StaticResource FloatingToolbarColor}" />
    <SolidColorBrush x:Key="FloatingToolbarBorderBrush" Color="{StaticResource FloatingToolbarBorderColor}" />
    <SolidColorBrush x:Key="FloatingToolbarDividerBrush" Color="{StaticResource FloatingToolbarDividerColor}" />
    <SolidColorBrush x:Key="ToastSurfaceBrush" Color="{StaticResource ToastSurfaceColor}" />
    <SolidColorBrush x:Key="ToastForegroundBrush" Color="{StaticResource ToastForegroundColor}" />
    <SolidColorBrush x:Key="ToastHoverBrush" Color="{StaticResource ToastHoverColor}" />
    <SolidColorBrush x:Key="PreviewOverlayBrush" Color="{StaticResource PreviewOverlayColor}" />
    <SolidColorBrush x:Key="PreviewBadgeBrush" Color="{StaticResource PreviewBadgeColor}" />
    <SolidColorBrush x:Key="DimensionBadgeBrush" Color="{StaticResource DimensionBadgeColor}" />
    <SolidColorBrush x:Key="ResizeGripBrush" Color="{StaticResource ResizeGripColor}" />
    <SolidColorBrush x:Key="OverlayButtonBrush" Color="{StaticResource OverlayButtonColor}" />
    <SolidColorBrush x:Key="OverlayButtonHoverBrush" Color="{StaticResource OverlayButtonHoverColor}" />

    <DropShadowEffect
        x:Key="WindowShadow"
        BlurRadius="18"
        Color="#FF172321"
        Direction="270"
        Opacity="0.25"
        ShadowDepth="4" />
</ResourceDictionary>
