    <SolidColorBrush
        x:Key="PanelBrush"
        Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush
        x:Key="HistorySurfaceBrush"
        Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush
        x:Key="ChromeBrush"
