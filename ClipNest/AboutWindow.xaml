<Window
    x:Class="ClipNest.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="关于 ClipNest"
    Width="400"
    Height="330"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI"
    PreviewKeyDown="Window_PreviewKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Border
        Margin="10"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource LineBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Effect="{StaticResource WindowShadow}">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="42"
                    Height="42"
                    Margin="0,0,12,0"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="Assets/ClipNest.ico" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource InkBrush}"
                        Text="ClipNest" />
                    <TextBlock
                        x:Name="VersionTextBlock"
                        Margin="0,3,0,0"
                        FontSize="10.5"
                        Foreground="{StaticResource MutedBrush}"
                        Text="ClipNest" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="26"
                    Height="26"
                    AutomationProperties.Name="关闭关于页面"
                    Click="CloseButton_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="关闭">
                    <Path
                        Width="9"
                        Height="9"
                        Data="M2,2 L10,10 M10,2 L2,10"
                        Style="{StaticResource IconPathStyle}" />
                </Button>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Margin="0,18,0,0"
                FontSize="12"
                Foreground="{StaticResource InkBrush}"
                LineHeight="19"
                Text="轻巧、常驻桌面最上层的 Windows 粘贴板历史工具。历史记录仅保存在本机。"
                TextWrapping="Wrap" />

            <Border
                Grid.Row="2"
                Margin="0,18,0,0"
                Padding="14,10"
                Background="#FFF7F9F6"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource MutedBrush}"
                        Text="运行环境" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        FontSize="11"
                        Foreground="{StaticResource InkBrush}"
                        Text=".NET Framework 4.8" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        FontSize="11"
                        Foreground="{StaticResource MutedBrush}"
                        Text="许可证" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="18,8,0,0"
                        FontSize="11"
                        Foreground="{StaticResource InkBrush}"
                        Text="MIT License" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        FontSize="11"
                        Foreground="{StaticResource MutedBrush}"
                        Text="数据位置" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="18,8,0,0"
                        FontSize="11"
                        Foreground="{StaticResource InkBrush}"
                        Text="%LOCALAPPDATA%\ClipNest" />
                </Grid>
            </Border>

            <Button
                Grid.Row="4"
                MinWidth="80"
                Padding="14,7"
                HorizontalAlignment="Right"
                Click="CloseButton_Click"
                Content="关闭"
                IsDefault="True"
                Style="{StaticResource TextButtonStyle}" />
        </Grid>
    </Border>
</Window>
